<mujoco model="MicroDog_preview">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.75 0.75 0.75" ambient="0.35 0.35 0.35" specular="0.2 0.2 0.2"/>
    <global azimuth="135" elevation="-18"/>
  </visual>

  <default>
    <joint damping="0.12" armature="0.0002"/>
    <geom friction="0.9 0.02 0.002" condim="3"/>
    <position kp="2.5" forcerange="-0.52 0.52"/>
  </default>

  <asset>
    <material name="body_mat" rgba="0.18 0.20 0.24 1"/>
    <material name="motor_mat" rgba="0.08 0.08 0.09 1"/>
    <material name="link_mat" rgba="0.65 0.67 0.72 1"/>
    <material name="accent_mat" rgba="0.15 0.45 0.85 1"/>
    <material name="ground_mat" rgba="0.82 0.84 0.86 1"/>
  </asset>

  <!-- 충돌 비트: 1=일반 형상, 2=몸통, 4=머리 yaw 모터,
       8=머리 roll 모터/외피, 16=꼬리 pitch 및 다리 upper 모터.
       2↔16, 4↔8만 제외하며 나머지 자기충돌과 지면 충돌은 유지한다. -->
  <worldbody>
    <light pos="0 -1 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="ground_mat"/>

    <!-- ~25 cm class MicroDog preview body -->
    <body name="base" pos="0 0 0.215">
      <freejoint/>
      <geom contype="2" conaffinity="15" name="torso" type="box" size="0.105 0.055 0.032"
            mass="0.42" material="body_mat"/>

      <!-- simple top electronics/battery volume -->
      <geom name="top_pack" type="box" pos="0 0 0.043"
            size="0.060 0.038 0.012" mass="0.13" material="accent_mat"/>

      <!-- head, 3 DOF visual/servo chain -->
      <body name="head_yaw" pos="0.118 0 0.015">
        <joint name="head_yaw_joint" type="hinge" axis="0 0 1" range="-70 70"/>
        <geom contype="4" conaffinity="23" type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
        <body name="head_pitch">
          <joint name="head_pitch_joint" type="hinge" axis="0 1 0" range="-45 45"/>
          <geom type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
          <body name="head_roll">
            <joint name="head_roll_joint" type="hinge" axis="1 0 0" range="-35 35"/>
            <geom contype="8" conaffinity="27" type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
            <geom contype="8" conaffinity="27" name="head_shell" type="box" pos="0.030 0 0"
                  size="0.035 0.040 0.030" mass="0.07" material="body_mat"/>
            <geom name="camera" type="box" pos="0.066 0 0.004"
                  size="0.008 0.020 0.014" mass="0.01" material="accent_mat"/>
          </body>
        </body>
      </body>

      <!-- tail, 2 DOF -->
      <body name="tail_yaw" pos="-0.112 0 0.010">
        <joint name="tail_yaw_joint" type="hinge" axis="0 0 1" range="-55 55"/>
        <geom type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
        <body name="tail_pitch">
          <joint name="tail_pitch_joint" type="hinge" axis="0 1 0" range="-35 35"/>
          <geom contype="16" conaffinity="29" type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
          <geom type="capsule" fromto="-0.005 0 0 -0.080 0 0"
                size="0.008" mass="0.025" material="accent_mat"/>
        </body>
      </body>

      <!-- FRONT LEFT -->
      <body name="fl_hip_roll" pos="0.075 0.065 0">
        <joint name="fl_hip_roll_joint" type="hinge" axis="1 0 0" range="-35 35"/>
        <geom type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
        <body name="fl_upper">
          <joint name="fl_hip_pitch_joint" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom contype="16" conaffinity="29" type="box" size="0.013 0.010 0.017" mass="0.018" material="motor_mat"/>
          <geom type="capsule" fromto="0 0 -0.015 0 0 -0.090"
                size="0.009" mass="0.025" material="link_mat"/>
          <body name="fl_lower" pos="0 0 -0.090">
            <joint name="fl_knee_joint" type="hinge" axis="0 1 0" range="-5 135"/>
            <geom type="box" size="0.013 0.010 0.017" mass="0.018" material="motor_mat"/>
            <geom type="capsule" fromto="0 0 -0.015 0 0 -0.090"
                  size="0.008" mass="0.020" material="link_mat"/>
            <geom type="sphere" pos="0 0 -0.095" size="0.016"
                  mass="0.008" friction="1.2 0.03 0.003" material="accent_mat"/>
          </body>
        </body>
      </body>

      <!-- FRONT RIGHT -->
      <body name="fr_hip_roll" pos="0.075 -0.065 0">
        <joint name="fr_hip_roll_joint" type="hinge" axis="1 0 0" range="-35 35"/>
        <geom type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
        <body name="fr_upper">
          <joint name="fr_hip_pitch_joint" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom contype="16" conaffinity="29" type="box" size="0.013 0.010 0.017" mass="0.018" material="motor_mat"/>
          <geom type="capsule" fromto="0 0 -0.015 0 0 -0.090"
                size="0.009" mass="0.025" material="link_mat"/>
          <body name="fr_lower" pos="0 0 -0.090">
            <joint name="fr_knee_joint" type="hinge" axis="0 1 0" range="-5 135"/>
            <geom type="box" size="0.013 0.010 0.017" mass="0.018" material="motor_mat"/>
            <geom type="capsule" fromto="0 0 -0.015 0 0 -0.090"
                  size="0.008" mass="0.020" material="link_mat"/>
            <geom type="sphere" pos="0 0 -0.095" size="0.016"
                  mass="0.008" friction="1.2 0.03 0.003" material="accent_mat"/>
          </body>
        </body>
      </body>

      <!-- REAR LEFT -->
      <body name="rl_hip_roll" pos="-0.075 0.065 0">
        <joint name="rl_hip_roll_joint" type="hinge" axis="1 0 0" range="-35 35"/>
        <geom type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
        <body name="rl_upper">
          <joint name="rl_hip_pitch_joint" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom contype="16" conaffinity="29" type="box" size="0.013 0.010 0.017" mass="0.018" material="motor_mat"/>
          <geom type="capsule" fromto="0 0 -0.015 0 0 -0.090"
                size="0.009" mass="0.025" material="link_mat"/>
          <body name="rl_lower" pos="0 0 -0.090">
            <joint name="rl_knee_joint" type="hinge" axis="0 1 0" range="-5 135"/>
            <geom type="box" size="0.013 0.010 0.017" mass="0.018" material="motor_mat"/>
            <geom type="capsule" fromto="0 0 -0.015 0 0 -0.090"
                  size="0.008" mass="0.020" material="link_mat"/>
            <geom type="sphere" pos="0 0 -0.095" size="0.016"
                  mass="0.008" friction="1.2 0.03 0.003" material="accent_mat"/>
          </body>
        </body>
      </body>

      <!-- REAR RIGHT -->
      <body name="rr_hip_roll" pos="-0.075 -0.065 0">
        <joint name="rr_hip_roll_joint" type="hinge" axis="1 0 0" range="-35 35"/>
        <geom type="box" size="0.010 0.013 0.017" mass="0.018" material="motor_mat"/>
        <body name="rr_upper">
          <joint name="rr_hip_pitch_joint" type="hinge" axis="0 1 0" range="-80 80"/>
          <geom contype="16" conaffinity="29" type="box" size="0.013 0.010 0.017" mass="0.018" material="motor_mat"/>
          <geom type="capsule" fromto="0 0 -0.015 0 0 -0.090"
                size="0.009" mass="0.025" material="link_mat"/>
          <body name="rr_lower" pos="0 0 -0.090">
            <joint name="rr_knee_joint" type="hinge" axis="0 1 0" range="-5 135"/>
            <geom type="box" size="0.013 0.010 0.017" mass="0.018" material="motor_mat"/>
            <geom type="capsule" fromto="0 0 -0.015 0 0 -0.090"
                  size="0.008" mass="0.020" material="link_mat"/>
            <geom type="sphere" pos="0 0 -0.095" size="0.016"
                  mass="0.008" friction="1.2 0.03 0.003" material="accent_mat"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position joint="fl_hip_roll_joint"  ctrlrange="-35 35"/>
    <position joint="fl_hip_pitch_joint" ctrlrange="-80 80"/>
    <position joint="fl_knee_joint"      ctrlrange="-5 135"/>

    <position joint="fr_hip_roll_joint"  ctrlrange="-35 35"/>
    <position joint="fr_hip_pitch_joint" ctrlrange="-80 80"/>
    <position joint="fr_knee_joint"      ctrlrange="-5 135"/>

    <position joint="rl_hip_roll_joint"  ctrlrange="-35 35"/>
    <position joint="rl_hip_pitch_joint" ctrlrange="-80 80"/>
    <position joint="rl_knee_joint"      ctrlrange="-5 135"/>

    <position joint="rr_hip_roll_joint"  ctrlrange="-35 35"/>
    <position joint="rr_hip_pitch_joint" ctrlrange="-80 80"/>
    <position joint="rr_knee_joint"      ctrlrange="-5 135"/>

    <position joint="head_yaw_joint"   ctrlrange="-70 70"/>
    <position joint="head_pitch_joint" ctrlrange="-45 45"/>
    <position joint="head_roll_joint"  ctrlrange="-35 35"/>
    <position joint="tail_yaw_joint"   ctrlrange="-55 55"/>
    <position joint="tail_pitch_joint" ctrlrange="-35 35"/>
  </actuator>
</mujoco>
